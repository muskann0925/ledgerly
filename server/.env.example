# Server Environment Configuration Template

# Server Port & Environment Mode
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billing_db?schema=public"

# Frontend Web Client URL (for CORS validation)
FRONTEND_URL=http://localhost:5173

# JWT Authentication Configuration (Use strong 32+ character secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_change_in_prod
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email Service Configuration (Optional: Required for 2FA OTP & Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
SMTP_FROM="Ledgerly Billing <no-reply@ledgerly.com>"

# Registration Lock Override (Default: false)
# When set to false, public registration is locked after the first Owner registers.
# Set to true only if you want open public registration.
ENABLE_REGISTRATION=false